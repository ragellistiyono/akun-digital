  "components": [
    {
      "name": "Tombol Utama",
      "kind": "button",
      "refersTo": "tombol-utama",
      "description": "Satu aksi utama per layar; latar ungu aksi dengan teks putih.",
      "html": "<button class=\"ds-btn-utama\">Bayar dengan QRIS</button>",
      "css": ":host{--langit:#2A1F4D;--langit-2:#3A2D66;--langit-garis:#5B4A92;--langit-teks:#E9E2FF;--langit-redup:#C7BDEA;--monogram:#8F61FF;--aksi:#7548F2;--aksi-tekan:#6236DE;--aksi-teks:#6A3FE0;--matahari:#EBC967;--persik:#ED9065;--persik-teks:#3A1D0E;--tanah:#F7F3FC;--permukaan:#FFFFFF;--permukaan-2:#EFE9FA;--garis:#E4DCF5;--tinta:#1E1838;--tinta-redup:#625879;--bayang:0 8px 24px -12px rgba(42,31,77,.38);--bayang-naik:0 14px 32px -14px rgba(42,31,77,.5);--font:'Manrope',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-btn-utama{height:52px;padding:0 24px;border:0;border-radius:14px;background:var(--aksi);color:#fff;font:800 16px var(--font);display:inline-flex;align-items:center;gap:8px;cursor:pointer;transition:background .15s,transform .1s} .ds-btn-utama:hover{background:var(--aksi-tekan)} .ds-btn-utama:active{transform:scale(.98)} .ds-btn-utama:focus-visible{outline:3px solid var(--monogram);outline-offset:2px} .ds-btn-utama[disabled]{background:var(--permukaan-2);color:var(--tinta-redup);cursor:not-allowed}"
    },
    {
      "name": "Tombol Garis",
      "kind": "button",
      "refersTo": "tombol-garis",
      "description": "Aksi kedua: Batalkan, Pakai voucher, Daftar, WhatsApp.",
      "html": "<button class=\"ds-btn-garis\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12a8 8 0 0 1-11.8 7L3 21l2-6.2A8 8 0 1 1 21 12z\"/></svg>Tanya lewat WhatsApp</button>",
      "css": ":host{--langit:#2A1F4D;--langit-2:#3A2D66;--langit-garis:#5B4A92;--langit-teks:#E9E2FF;--langit-redup:#C7BDEA;--monogram:#8F61FF;--aksi:#7548F2;--aksi-tekan:#6236DE;--aksi-teks:#6A3FE0;--matahari:#EBC967;--persik:#ED9065;--persik-teks:#3A1D0E;--tanah:#F7F3FC;--permukaan:#FFFFFF;--permukaan-2:#EFE9FA;--garis:#E4DCF5;--tinta:#1E1838;--tinta-redup:#625879;--bayang:0 8px 24px -12px rgba(42,31,77,.38);--bayang-naik:0 14px 32px -14px rgba(42,31,77,.5);--font:'Manrope',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-btn-garis{height:52px;padding:0 24px;border:1.5px solid var(--garis);border-radius:14px;background:var(--permukaan);color:var(--tinta);font:800 16px var(--font);display:inline-flex;align-items:center;gap:8px;cursor:pointer;transition:border-color .15s,transform .1s} .ds-btn-garis:hover{border-color:var(--monogram)} .ds-btn-garis:active{transform:scale(.98)} .ds-btn-garis:focus-visible{outline:3px solid var(--monogram);outline-offset:2px}"
    },
    {
      "name": "Isian",
      "kind": "input",
      "refersTo": "isian",
      "description": "Isian 52 px dengan label di atas dan teks bantuan di bawah.",
      "html": "<label class=\"ds-lbl\" for=\"ds-email\">Email</label><input class=\"ds-isian\" id=\"ds-email\" type=\"email\" placeholder=\"nama@email.com\"><p class=\"ds-bantuan\">Pastikan email benar, detail pesanan dikirim ke sini.</p>",
      "css": ":host{--langit:#2A1F4D;--langit-2:#3A2D66;--langit-garis:#5B4A92;--langit-teks:#E9E2FF;--langit-redup:#C7BDEA;--monogram:#8F61FF;--aksi:#7548F2;--aksi-tekan:#6236DE;--aksi-teks:#6A3FE0;--matahari:#EBC967;--persik:#ED9065;--persik-teks:#3A1D0E;--tanah:#F7F3FC;--permukaan:#FFFFFF;--permukaan-2:#EFE9FA;--garis:#E4DCF5;--tinta:#1E1838;--tinta-redup:#625879;--bayang:0 8px 24px -12px rgba(42,31,77,.38);--bayang-naik:0 14px 32px -14px rgba(42,31,77,.5);--font:'Manrope',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-lbl{display:block;font:700 14px var(--font);color:var(--tinta);margin-bottom:8px} .ds-isian{width:100%;max-width:360px;height:52px;border:1.5px solid var(--garis);border-radius:14px;background:var(--permukaan);color:var(--tinta);padding:0 16px;font:400 16px var(--font);outline:0;transition:border-color .15s} .ds-isian:hover{border-color:var(--monogram)} .ds-isian:focus{border-color:var(--aksi);box-shadow:0 0 0 3px color-mix(in srgb,var(--monogram) 30%,transparent)} .ds-bantuan{font:400 13px var(--font);color:var(--tinta-redup);margin-top:8px}"
    },
    {
      "name": "Chip Kategori",
      "kind": "chip",
      "refersTo": "chip-kategori",
      "description": "Penyaring Kategori di Beranda; terpilih berlatar langit.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Semua</button><button class=\"ds-chip\" aria-pressed=\"false\">Streaming</button><button class=\"ds-chip\" aria-pressed=\"false\">Musik</button></div>",
      "css": ":host{--langit:#2A1F4D;--langit-2:#3A2D66;--langit-garis:#5B4A92;--langit-teks:#E9E2FF;--langit-redup:#C7BDEA;--monogram:#8F61FF;--aksi:#7548F2;--aksi-tekan:#6236DE;--aksi-teks:#6A3FE0;--matahari:#EBC967;--persik:#ED9065;--persik-teks:#3A1D0E;--tanah:#F7F3FC;--permukaan:#FFFFFF;--permukaan-2:#EFE9FA;--garis:#E4DCF5;--tinta:#1E1838;--tinta-redup:#625879;--bayang:0 8px 24px -12px rgba(42,31,77,.38);--bayang-naik:0 14px 32px -14px rgba(42,31,77,.5);--font:'Manrope',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-chips{display:flex;gap:8px} .ds-chip{height:40px;padding:0 16px;border-radius:999px;background:var(--permukaan);border:1.5px solid var(--garis);color:var(--tinta);font:700 14px var(--font);cursor:pointer;transition:background .2s,border-color .2s} .ds-chip:hover{border-color:var(--monogram)} .ds-chip:focus-visible{outline:3px solid var(--monogram);outline-offset:2px} .ds-chip[aria-pressed=true]{background:var(--langit);border-color:var(--langit);color:#fff}"
    },
    {
      "name": "Kartu Produk",
      "kind": "card",
      "refersTo": "kartu-produk",
      "description": "Kartu katalog: foto sampul, nama, harga Mulai, Harga normal dicoret, Hemat dari Varian sumber harga.",
      "html": "<a class=\"ds-kartu\" href=\"#\"><div class=\"ds-foto\"><span>Y</span></div><div class=\"ds-nama\">YouTube Premium</div><div class=\"ds-harga\">Mulai Rp 55.000</div><div class=\"ds-banding\"><span class=\"ds-coret\">Rp 65.000</span><span class=\"ds-hemat\">Hemat 15%</span></div></a>",
      "css": ":host{--langit:#2A1F4D;--langit-2:#3A2D66;--langit-garis:#5B4A92;--langit-teks:#E9E2FF;--langit-redup:#C7BDEA;--monogram:#8F61FF;--aksi:#7548F2;--aksi-tekan:#6236DE;--aksi-teks:#6A3FE0;--matahari:#EBC967;--persik:#ED9065;--persik-teks:#3A1D0E;--tanah:#F7F3FC;--permukaan:#FFFFFF;--permukaan-2:#EFE9FA;--garis:#E4DCF5;--tinta:#1E1838;--tinta-redup:#625879;--bayang:0 8px 24px -12px rgba(42,31,77,.38);--bayang-naik:0 14px 32px -14px rgba(42,31,77,.5);--font:'Manrope',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-kartu{display:flex;flex-direction:column;width:180px;background:var(--permukaan);border-radius:20px;padding:12px;box-shadow:var(--bayang);color:var(--tinta);text-decoration:none;font-family:var(--font);font-variant-numeric:tabular-nums;transition:transform .2s cubic-bezier(.16,1,.3,1),box-shadow .2s} .ds-kartu:hover{transform:translateY(-2px);box-shadow:var(--bayang-naik)} .ds-kartu:focus-visible{outline:3px solid var(--monogram);outline-offset:2px} .ds-foto{height:112px;border-radius:16px;background:var(--aksi);color:#fff;display:flex;align-items:flex-end;padding:12px;font-weight:800;font-size:32px;line-height:1} .ds-nama{font-weight:800;font-size:16px;line-height:1.25;letter-spacing:-.01em;margin-top:12px} .ds-harga{font-weight:800;font-size:18px;letter-spacing:-.02em;margin-top:4px} .ds-banding{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:8px} .ds-coret{font-size:14px;font-weight:600;color:var(--tinta-redup);text-decoration:line-through} .ds-hemat{background:var(--persik);color:var(--persik-teks);font-weight:800;font-size:12px;padding:4px 8px;border-radius:999px}"
    },
    {
      "name": "Pil Status Pesanan",
      "kind": "chip",
      "refersTo": "status-menunggu",
      "description": "Enam status Pesanan: warna, ikon, dan label selalu bersama.",
      "html": "<div class=\"ds-st-wadah\"><span class=\"ds-st ds-st-tunggu\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg>Menunggu Pembayaran</span><span class=\"ds-st ds-st-selesai\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Selesai</span><span class=\"ds-st ds-st-kedaluwarsa\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 3h12M6 21h12M7 3c0 5 10 5 10 9s-10 4-10 9M17 3c0 5-10 5-10 9s10 4 10 9\"/></svg>Kedaluwarsa</span><span class=\"ds-st ds-st-batal\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m15 9-6 6M9 9l6 6\"/></svg>Dibatalkan</span><span class=\"ds-st ds-st-masalah\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/><path d=\"M12 9v4M12 17h.01\"/></svg>Bermasalah</span><span class=\"ds-st ds-st-kembali\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 2.6-6.4\"/><path d=\"M3 4v5h5\"/></svg>Dana Dikembalikan</span></div>",
      "css": " .ds-st-wadah{display:flex;flex-wrap:wrap;gap:8px} .ds-st{display:inline-flex;align-items:center;gap:4px;height:28px;padding:0 12px 0 8px;border-radius:999px;font:800 13px 'Manrope',system-ui,sans-serif;white-space:nowrap} .ds-st-tunggu{background:#FFF1C9;color:#6E4B00} .ds-st-selesai{background:#DAF3E5;color:#18603E} .ds-st-kedaluwarsa{background:#ECE7F2;color:#554D68} .ds-st-batal{background:#ECEDF0;color:#4E5460} .ds-st-masalah{background:#FCE0DD;color:#9C2820} .ds-st-kembali{background:#DFE8FC;color:#22448F}"
    },
    {
      "name": "Navigasi Bawah dengan Penanda Surya",
      "kind": "nav",
      "refersTo": "navigasi-bawah",
      "description": "Empat tab di ponsel; matahari terbit setengah lingkaran menandai tab aktif dan bergeser saat tab berpindah.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z\"/></svg>Beranda</a><a href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"2\"/></svg>Kategori</a><a href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 3-6.7L3 8\"/><path d=\"M3 3v5h5\"/><path d=\"M12 7v5l3 2\"/></svg>Riwayat</a><a href=\"#\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6\"/></svg>Akun</a><span class=\"ds-surya\" aria-hidden=\"true\"></span></nav>",
      "css": ":host{--langit:#2A1F4D;--langit-2:#3A2D66;--langit-garis:#5B4A92;--langit-teks:#E9E2FF;--langit-redup:#C7BDEA;--monogram:#8F61FF;--aksi:#7548F2;--aksi-tekan:#6236DE;--aksi-teks:#6A3FE0;--matahari:#EBC967;--persik:#ED9065;--persik-teks:#3A1D0E;--tanah:#F7F3FC;--permukaan:#FFFFFF;--permukaan-2:#EFE9FA;--garis:#E4DCF5;--tinta:#1E1838;--tinta-redup:#625879;--bayang:0 8px 24px -12px rgba(42,31,77,.38);--bayang-naik:0 14px 32px -14px rgba(42,31,77,.5);--font:'Manrope',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-nav{position:relative;display:grid;grid-template-columns:repeat(4,1fr);width:390px;height:76px;margin-top:20px;background:var(--permukaan);border-top:1px solid var(--garis)} .ds-nav a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font:700 12px var(--font);color:var(--tinta-redup);text-decoration:none} .ds-nav a:hover{color:var(--tinta)} .ds-nav a:focus-visible{outline:3px solid var(--monogram);outline-offset:-3px;border-radius:10px} .ds-nav a[aria-current=page]{color:var(--tinta)} .ds-surya{position:absolute;top:-1px;left:0;width:25%;height:14px;pointer-events:none;transition:transform .45s cubic-bezier(.16,1,.3,1)} .ds-surya:before{content:'';position:absolute;left:50%;top:-13px;width:28px;height:14px;margin-left:-14px;border-radius:14px 14px 0 0;background:var(--matahari);box-shadow:0 -2px 14px 3px rgba(235,201,103,.55)} .ds-nav:has(a:nth-child(2):hover) .ds-surya{transform:translateX(100%)} .ds-nav:has(a:nth-child(3):hover) .ds-surya{transform:translateX(200%)} .ds-nav:has(a:nth-child(4):hover) .ds-surya{transform:translateX(300%)}"
    },
    {
      "name": "Blok Item stok",
      "kind": "custom",
      "refersTo": "blok-item-stok",
      "description": "Item stok di Halaman Pesanan: blok langit, nilai mono, tombol Salin per kolom.",
      "html": "<div class=\"ds-item\"><div class=\"ds-item-baris\"><div><small>Email</small><span>miwe.akun07@contoh.id</span></div><button class=\"ds-salin\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M5 15V5a2 2 0 0 1 2-2h10\"/></svg>Salin</button></div><div class=\"ds-item-baris\"><div><small>Password</small><span>Senja-7419</span></div><button class=\"ds-salin\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M5 15V5a2 2 0 0 1 2-2h10\"/></svg>Salin</button></div></div>",
      "css": ":host{--langit:#2A1F4D;--langit-2:#3A2D66;--langit-garis:#5B4A92;--langit-teks:#E9E2FF;--langit-redup:#C7BDEA;--monogram:#8F61FF;--aksi:#7548F2;--aksi-tekan:#6236DE;--aksi-teks:#6A3FE0;--matahari:#EBC967;--persik:#ED9065;--persik-teks:#3A1D0E;--tanah:#F7F3FC;--permukaan:#FFFFFF;--permukaan-2:#EFE9FA;--garis:#E4DCF5;--tinta:#1E1838;--tinta-redup:#625879;--bayang:0 8px 24px -12px rgba(42,31,77,.38);--bayang-naik:0 14px 32px -14px rgba(42,31,77,.5);--font:'Manrope',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-item{max-width:380px;background:var(--langit);color:var(--langit-teks);border-radius:24px;padding:8px 16px;font-family:var(--font)} .ds-item-baris{display:grid;grid-template-columns:1fr auto;align-items:center;gap:8px;padding:12px 0;border-bottom:1px solid var(--langit-garis)} .ds-item-baris:last-child{border-bottom:0} .ds-item-baris small{display:block;font-size:12px;font-weight:700;color:var(--langit-redup)} .ds-item-baris span{font-family:var(--mono);font-size:15px;font-weight:500;color:#fff;overflow-wrap:anywhere} .ds-salin{height:40px;padding:0 12px;border-radius:12px;background:var(--langit-2);color:var(--langit-teks);border:1.5px solid var(--langit-garis);font:800 14px var(--font);display:inline-flex;align-items:center;gap:8px;cursor:pointer} .ds-salin:hover{border-color:var(--monogram)} .ds-salin:focus-visible{outline:3px solid var(--monogram);outline-offset:2px} .ds-salin:active{background:#DAF3E5;color:#18603E;border-color:transparent}"
    },
    {
      "name": "Pilihan Varian",
      "kind": "custom",
      "refersTo": "pilihan-varian",
      "description": "Radiogroup Varian di Halaman Produk: Stok Varian, Harga jual, Harga normal dicoret, Hemat; Varian habis tidak bisa dipilih.",
      "html": "<div class=\"ds-varian\" role=\"radiogroup\"><button class=\"ds-var\" role=\"radio\" aria-checked=\"true\"><span class=\"ds-radio\"></span><span><b>1 Bulan</b><small>Stok 12</small></span><span class=\"ds-r\"><b>Rp 50.000</b><s>Rp 75.000</s></span></button><button class=\"ds-var\" role=\"radio\" aria-checked=\"false\" disabled><span class=\"ds-radio\"></span><span><b>6 Bulan</b><small>Habis</small></span><span class=\"ds-r\"><b>Rp 250.000</b></span></button></div>",
      "css": ":host{--langit:#2A1F4D;--langit-2:#3A2D66;--langit-garis:#5B4A92;--langit-teks:#E9E2FF;--langit-redup:#C7BDEA;--monogram:#8F61FF;--aksi:#7548F2;--aksi-tekan:#6236DE;--aksi-teks:#6A3FE0;--matahari:#EBC967;--persik:#ED9065;--persik-teks:#3A1D0E;--tanah:#F7F3FC;--permukaan:#FFFFFF;--permukaan-2:#EFE9FA;--garis:#E4DCF5;--tinta:#1E1838;--tinta-redup:#625879;--bayang:0 8px 24px -12px rgba(42,31,77,.38);--bayang-naik:0 14px 32px -14px rgba(42,31,77,.5);--font:'Manrope',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace} .ds-varian{display:grid;gap:8px;max-width:380px} .ds-var{display:grid;grid-template-columns:24px 1fr auto;align-items:center;gap:12px;background:var(--permukaan);border:2px solid var(--garis);border-radius:20px;padding:16px;text-align:left;color:var(--tinta);font-family:var(--font);font-variant-numeric:tabular-nums;cursor:pointer;transition:border-color .15s,background .15s} .ds-var:hover:not([disabled]){border-color:var(--monogram)} .ds-var:focus-visible{outline:3px solid var(--monogram);outline-offset:2px} .ds-var[aria-checked=true]{border-color:var(--aksi);background:color-mix(in srgb,var(--monogram) 9%,var(--permukaan))} .ds-var[disabled]{opacity:.6;cursor:not-allowed} .ds-var b{display:block;font-size:16px;font-weight:800} .ds-var small{font-size:13px;font-weight:700;color:var(--tinta-redup)} .ds-r{text-align:right} .ds-r b{font-size:18px} .ds-r s{display:block;font-size:14px;font-weight:600;color:var(--tinta-redup)} .ds-radio{width:24px;height:24px;border-radius:50%;border:2px solid var(--garis);display:grid;place-items:center} .ds-var[aria-checked=true] .ds-radio{border-color:var(--aksi)} .ds-var[aria-checked=true] .ds-radio:after{content:'';width:12px;height:12px;border-radius:50%;background:var(--aksi)}"
    }
  ],
  "narrative": {
    "northStar": "Langit Senja",
    "overview": "Toko ini hidup di jam senja. Bagian atas setiap layar adalah langit malam-ungu yang memuat monogram MDS dan pemandangan gunung yang dilukis dengan kode. Di bawahnya terbentang tanah yang tenang: lavender pucat di mode terang, malam pekat di mode gelap. Di tanah itu kartu putih bersudut bulat melayang dengan bayangan ungu yang lembut. Matahari menjadi satu-satunya tanda yang bergerak di sistem ini. Ia menandai tab aktif, dan di Halaman bayar ia tenggelam mengikuti sisa waktu QRIS.\n\nKepadatannya kepadatan aplikasi belanja di ponsel. Ruangnya cukup untuk satu jempol: kontrol utama setinggi 52 px, chip 40 px, dan modul jarak 8 px. Huruf Manrope tebal dengan angka tabular membuat harga, Stok Varian, Total bayar, dan hitung mundur tidak menggeser tata letak saat angkanya berganti. Rasa percaya datang dari rincian yang jujur, bukan dari hiasan. Arah ini menolak grid kartu putih berheader ungu khas toko top-up, juga gradien ungu-neon yang berpendar.",
    "keyCharacteristics": [
      "Langit ungu malam di atas, tanah tenang di bawah, kartu bulat di antaranya.",
      "Pemandangan senja buatan kode, tidak memakai foto. Gradien hanya ada di langit dan kabut pemandangan.",
      "Matahari menjadi penanda tab aktif dan jam hitung mundur.",
      "Manrope tebal dengan angka tabular. JetBrains Mono hanya untuk Item stok dan Nomor Pesanan.",
      "Status selalu tampil sebagai warna, ikon, dan label sekaligus.",
      "Mode terang dan gelap setara. Keduanya divalidasi."
    ],
    "rules": [
      {
        "name": "Aturan Dua Ungu",
        "body": "Teks putih hanya diletakkan di atas `aksi` atau `aksi-tekan`, tidak pernah di atas `monogram`. `monogram` adalah warna merek untuk monogram dan huruf tampilan besar, bukan latar tombol.",
        "section": "colors"
      },
      {
        "name": "Aturan Gradien Senja",
        "body": "Gradien hanya ada di langit dan kabut pemandangan senja. Teks, tombol, kartu, chip, dan panel selalu berwarna datar. Efek kaca (backdrop-filter, blur di belakang permukaan) tidak dipakai di mana pun.",
        "section": "colors"
      },
      {
        "name": "Aturan Mono untuk Data Salinan",
        "body": "JetBrains Mono hanya dipakai untuk nilai Item stok dan Nomor Pesanan. Harga, tanggal, dan label tetap Manrope, termasuk tanggal yang bersebelahan dengan Nomor Pesanan di Riwayat.",
        "section": "typography"
      },
      {
        "name": "Aturan Angka Bersel Tetap",
        "body": "Stok Varian, Harga jual, Total bayar, dan hitung mundur memakai angka tabular, jadi pergantian angka tidak menggeser tata letak.",
        "section": "typography"
      },
      {
        "name": "Aturan Bayangan Berjarak",
        "body": "Bayangan kartu selalu lembut, lebar, dan menjauh dari tepi. Kartu tidak diberi garis tepi. Garis hanya untuk kontrol (isian, chip, tombol garis, pilihan Varian).",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do pakai token dari berkas ini lewat utilitas Tailwind atau `var(--…)`. Jangan menulis hex di komponen.",
      "Do letakkan teks putih hanya di atas `aksi` (5,3:1) atau `aksi-tekan`, dan pakai `monogram` untuk monogram, cincin fokus, garis hover, dan huruf tampilan besar.",
      "Do tampilkan setiap status Pesanan sebagai pil dengan warna, ikon lucide, dan label sekaligus.",
      "Do pakai angka tabular untuk Harga jual, Stok Varian, Total bayar, dan hitung mundur.",
      "Do pakai JetBrains Mono hanya untuk nilai Item stok dan Nomor Pesanan.",
      "Do ambil Harga normal yang dicoret dan Hemat di kartu \"Mulai Rp X\" dari Varian ber-stok yang menjadi sumber harga itu (PRD §3.8).",
      "Do letakkan aksi utama di bilah lekat berlatar `tanah` pekat di atas navigasi bawah pada layar di bawah 900 px.",
      "Do matikan semua transisi dan animasi, termasuk pergeseran matahari dan penggulungan navigasi, di bawah `prefers-reduced-motion: reduce`.",
      "Do jaga jarak dalam kelipatan 8 px, dan pakai 4 atau 12 px hanya di dalam komponen."
    ],
    "donts": [
      "Don't letakkan teks putih di atas `monogram` (3,9:1), termasuk warna sorotan teks (`::selection`).",
      "Don't pakai gradien di luar langit dan kabut pemandangan senja: tidak di teks, tombol, kartu, chip, atau panel.",
      "Don't pakai efek kaca (backdrop-filter) di mana pun.",
      "Don't ganti pemandangan senja dengan foto. Pemandangan itu dilukis dengan kode supaya tajam dan bisa menjadi jam hitung mundur.",
      "Don't tampilkan angka stok gabungan di kartu Produk. Kartu hanya menampilkan \"Habis\" bila semua Varian aktif habis.",
      "Don't tampilkan status hanya dengan warna.",
      "Don't tambahkan testimoni, rating, jumlah Pembeli, atau logo layanan pihak ketiga. Nama layanan hanya muncul sebagai nama Produk.",
      "Don't pakai bayangan keras bergeser, dan jangan beri garis tepi pada kartu."
    ]
  }
}