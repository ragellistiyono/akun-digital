# Copy this file to .env for local development.
# The local PostgreSQL starts with `docker compose up -d`.
DATABASE_URL=postgres://app:app@localhost:56434/app

# Better Auth (Admin login). Replace the secret with your own random value of at least 32 characters,
# for example from `openssl rand -base64 32`. BETTER_AUTH_URL is the address the store is opened at.
BETTER_AUTH_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000

# Folder for files uploaded by Admin (Kategori icons, Product photos). Relative paths start at the
# project folder. On the server, point it at a folder that survives redeploys.
UPLOAD_DIR=.unggahan/pengembangan

# Key that encrypts Item stok contents in the database. It must be 32 random bytes in base64, for
# example from `openssl rand -base64 32`. The value below is only an example for local development:
# replace it with your own on the server, keep a copy somewhere safe, and never change it once Item
# stok exist, because Item stok saved with the old key can no longer be opened.
ITEM_STOK_KEY=a3VuY2ktY29udG9oLXBlbmdlbWJhbmdhbi1sb2thbCE=

# Qrispy, the QRIS payment service (ADR-0004). "tiruan" uses the fake Qrispy for development and tests:
# it issues sample QRIS with a random Kode unik that cannot be paid with an e-wallet. Instead, POST
# {"qrisId": "<qris_id>", "amount": <nominal>} to /api/qrispy-tiruan/bayar marks that QRIS as paid; this
# trigger only works with QRISPY_MODE=tiruan. The real Qrispy is not available yet.
QRISPY_MODE=tiruan

# Secret that checks the signature of Qrispy webhooks sent to /api/qrispy/webhook (ADR-0004). Copy it from
# Qrispy Dashboard → Webhook Settings. The value below is only an example for local development.
QRISPY_WEBHOOK_SECRET=contoh-secret-webhook-qrispy-pengembangan

# Email to Buyers (PRD §10). EMAIL_MODE picks the implementation: "tiruan" sends nothing and only keeps
# each email in the memory of the app process, for development and tests; "resend" sends through the
# Resend HTTP API with RESEND_API_KEY, which stays on the server. EMAIL_FROM is the sender, and APP_URL is
# the store address that Tautan Pesanan in emails point to. The domain miwe.example is only an example
# until the store domain is decided (OD-1) [CONTOH].
EMAIL_MODE=tiruan
RESEND_API_KEY=
EMAIL_FROM=MIWE Digital Store <no-reply@miwe.example>
APP_URL=https://miwe.example
