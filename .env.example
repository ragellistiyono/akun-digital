# Copy this file to .env for local development.
# The local PostgreSQL starts with `docker compose up -d`.
DATABASE_URL=postgres://app:app@localhost:56434/app

# Better Auth (Admin login). Replace the secret with your own random value of at least 32 characters,
# for example from `openssl rand -base64 32`. BETTER_AUTH_URL is the address the store is opened at.
BETTER_AUTH_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000
