# Test environment. End-to-end tests always load this file, so they never touch the development database `app`.
# On your machine it points at this project's own PostgreSQL from docker-compose.yml, database app_test.
# CI points the port at its own PostgreSQL service before loading this file. No real secrets.
DATABASE_URL=postgres://app:app@localhost:56434/app_test

# Better Auth for tests only. This secret protects nothing real; never reuse it outside tests.
BETTER_AUTH_SECRET=rahasia-test-ci-bukan-rahasia-asli-7Qm2Vx9LkP4sZt8R
BETTER_AUTH_URL=http://localhost:3100

# Upload folder for tests only, separate from the development upload folder in .env.example.
UPLOAD_DIR=.unggahan/test
