# Test environment. End-to-end tests always load this file, so they never touch the development database `app`.
# On your machine it points at this project's own PostgreSQL from docker-compose.yml, database app_test.
# CI points the port at its own PostgreSQL service before loading this file. No real secrets.
DATABASE_URL=postgres://app:app@localhost:56434/app_test

# Better Auth for tests only. This secret protects nothing real; never reuse it outside tests.
BETTER_AUTH_SECRET=rahasia-test-ci-bukan-rahasia-asli-7Qm2Vx9LkP4sZt8R
BETTER_AUTH_URL=http://localhost:3100

# Upload folder for tests only, separate from the development upload folder in .env.example.
UPLOAD_DIR=.unggahan/test

# Item stok encryption key for tests only (base64 of the text "kunci-uji-ci-bukan-rahasia-asli!").
# It protects nothing real; never reuse it outside tests.
ITEM_STOK_KEY=a3VuY2ktdWppLWNpLWJ1a2FuLXJhaGFzaWEtYXNsaSE=

# Fake Qrispy for tests (ADR-0004): sample QRIS that cannot be paid with real money. Tests mark a QRIS as
# paid through POST /api/qrispy-tiruan/bayar, which only works with QRISPY_MODE=tiruan.
QRISPY_MODE=tiruan

# Qrispy webhook secret for tests only (ADR-0004). It protects nothing real; never reuse it outside tests.
QRISPY_WEBHOOK_SECRET=secret-webhook-uji-ci-bukan-rahasia-asli

# Fake email for tests (EMAIL_MODE=tiruan): nothing is sent, and tests read the emails kept in memory. The
# Resend key below protects nothing real; never reuse it outside tests. The sender and store address use
# the example domain of OD-1 [CONTOH].
EMAIL_MODE=tiruan
RESEND_API_KEY=re_uji_ci_bukan_kunci_asli_4Wq8Zr2Np6Tx
EMAIL_FROM=MIWE Digital Store <no-reply@miwe.example>
APP_URL=https://miwe.example
